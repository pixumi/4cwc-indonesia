---
import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminSidebar from "../../components/AdminSidebar.astro";
import LangSwitch from "../../components/LangSwitch.astro";
import { formatDateTime } from "../../lib/i18n";

const db = env.DB;
const user = Astro.locals.user!;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

const seasons =
  (await db.prepare("SELECT id, year, label FROM seasons ORDER BY year DESC").all()).results ?? [];

const matches =
  (
    await db
      .prepare(
        `SELECT m.id, m.season_id, m.round, m.opponent, m.scheduled_at, m.status,
                m.score_us, m.score_them, m.mp_link, m.notes, m.sort_order, s.label as season_label
         FROM matches m JOIN seasons s ON s.id = m.season_id
         ORDER BY s.year DESC, m.sort_order ASC, COALESCE(m.scheduled_at, '9999') ASC, m.id ASC`,
      )
      .all()
  ).results ?? [];
---

<BaseLayout title={t("admin.matches.title")}>
  <div class="app-shell">
    <AdminSidebar active="matches" role={user.role} displayName={user.displayName} />

    <div class="app-main" style="max-width:1160px;">
      <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px;">
        <h1 style="font-size:27px; font-weight:600;">{t("admin.matches.title")}</h1>
        <LangSwitch />
      </div>

      {seasons.length === 0 ? (
        <p style="margin-top:24px; color:var(--text-muted); font-size:14px; line-height:1.6; max-width:640px;">
          {t("admin.noSeasons")}
        </p>
      ) : (
        <form
          method="POST"
          action="/api/matches/save"
          class="card"
          class="admin-form" style="margin-top:28px; padding:24px;"
        >
          <div>
            <label class="field-label" for="season_id">{t("admin.season")}</label>
            <select class="field-input" id="season_id" name="season_id" required>
              {(seasons as any[]).map((s) => <option value={s.id}>{s.label}</option>)}
            </select>
          </div>
          <div>
            <label class="field-label" for="round">{t("admin.round")}</label>
            <input class="field-input" id="round" name="round" required placeholder="Group Stage / Ro16 / QF" />
          </div>
          <div>
            <label class="field-label" for="opponent">{t("admin.opponent")}</label>
            <input class="field-input" id="opponent" name="opponent" required placeholder="Sweden" />
          </div>
          <div>
            <label class="field-label" for="scheduled_at">{t("admin.datetime")}</label>
            <input class="field-input" id="scheduled_at" name="scheduled_at" type="datetime-local" />
          </div>
          <div>
            <label class="field-label" for="status">{t("admin.status")}</label>
            <select class="field-input" id="status" name="status">
              <option value="scheduled">{t("match.upcoming")}</option>
              <option value="live">{t("match.live")}</option>
              <option value="done">{t("match.done")}</option>
            </select>
          </div>
          <div>
            <label class="field-label" for="mp_link">{t("admin.mplink")}</label>
            <input class="field-input" id="mp_link" name="mp_link" type="url" placeholder="https://osu.ppy.sh/mp/..." />
          </div>
          <div>
            <label class="field-label" for="score_us">{t("admin.scoreUs")}</label>
            <input class="field-input" id="score_us" name="score_us" type="number" min="0" />
          </div>
          <div>
            <label class="field-label" for="score_them">{t("admin.scoreThem")}</label>
            <input class="field-input" id="score_them" name="score_them" type="number" min="0" />
          </div>
          <div>
            <label class="field-label" for="sort_order">Sort</label>
            <input class="field-input" id="sort_order" name="sort_order" type="number" value="0" />
          </div>
          <div style="grid-column:1 / -1;">
            <label class="field-label" for="notes">Notes</label>
            <input class="field-input" id="notes" name="notes" />
          </div>
          <div style="grid-column:1 / -1;">
            <button type="submit" class="btn-primary">{t("admin.add")}</button>
          </div>
        </form>
      )}

      <div style="margin-top:32px; display:flex; flex-direction:column; gap:12px;">
        {(matches as any[]).map((m) => (
          <div class="card" style="padding:16px 20px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
            <div style="min-width:150px;">
              <div style="font-family:'Space Grotesk'; font-weight:600; font-size:14px;">{m.round}</div>
              <div style="font-size:11.5px; color:var(--text-muted); margin-top:3px;">{m.season_label}</div>
            </div>
            <div style="flex:1; min-width:180px; font-size:14px;">
              Indonesia <span style="color:var(--text-muted);">{t("match.vs")}</span> <strong>{m.opponent}</strong>
            </div>
            <div style="font-size:12px; color:var(--text-muted); min-width:150px;">
              {formatDateTime(m.scheduled_at, lang) ?? t("match.tbd")}
            </div>
            {m.status === "done" && m.score_us !== null && m.score_them !== null && (
              <div class="display" style="font-size:15px; font-weight:700;">{m.score_us} – {m.score_them}</div>
            )}
            <span class="badge badge-muted">{m.status}</span>
            <form method="POST" action="/api/matches/save" onsubmit="return confirm('Delete?')">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={m.id} />
              <button type="submit" class="btn-ghost" style="font-size:12.5px;">{t("admin.delete")}</button>
            </form>
          </div>
        ))}
        {matches.length === 0 && seasons.length > 0 && (
          <p style="color:var(--text-muted); font-size:14px;">{t("match.empty")}</p>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
