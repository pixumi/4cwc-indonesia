---
import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminSidebar from "../../components/AdminSidebar.astro";
import LangSwitch from "../../components/LangSwitch.astro";

const db = env.DB;
const user = Astro.locals.user!;
const t = Astro.locals.t;

const seasons =
  (await db.prepare("SELECT id, year, label FROM seasons ORDER BY year DESC").all()).results ?? [];

const rows =
  (
    await db
      .prepare(
        `SELECT ti.id, ti.season_id, ti.kind, ti.label, ti.value, ti.visible_to, ti.sort_order, s.label as season_label
         FROM team_info ti LEFT JOIN seasons s ON s.id = ti.season_id
         ORDER BY ti.sort_order ASC, ti.id ASC`,
      )
      .all()
  ).results ?? [];
---

<BaseLayout title={t("admin.info.title")}>
  <div style="display:flex; width:100%;">
    <AdminSidebar active="team-info" role={user.role} displayName={user.displayName} />

    <div style="flex:1; padding:44px 56px 64px 56px; max-width:1160px;">
      <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px;">
        <h1 style="font-size:27px; font-weight:600;">{t("admin.info.title")}</h1>
        <LangSwitch />
      </div>

      <form
        method="POST"
        action="/api/team-info/save"
        class="card"
        style="margin-top:28px; padding:24px; display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;"
      >
        <div>
          <label class="field-label" for="label">{t("admin.label")}</label>
          <input class="field-input" id="label" name="label" required />
        </div>
        <div>
          <label class="field-label" for="kind">{t("admin.kind")}</label>
          <select class="field-input" id="kind" name="kind">
            <option value="note">note</option>
            <option value="link">link</option>
            <option value="contact">contact</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="visible_to">{t("admin.visibleTo")}</label>
          <select class="field-input" id="visible_to" name="visible_to">
            <option value="roster">roster</option>
            <option value="admin">admin</option>
          </select>
        </div>
        <div>
          <label class="field-label" for="season_id">{t("admin.season")}</label>
          <select class="field-input" id="season_id" name="season_id">
            <option value="">— semua musim —</option>
            {(seasons as any[]).map((s) => <option value={s.id}>{s.label}</option>)}
          </select>
        </div>
        <div>
          <label class="field-label" for="sort_order">Sort</label>
          <input class="field-input" id="sort_order" name="sort_order" type="number" value="0" />
        </div>
        <div style="grid-column:1 / -1;">
          <label class="field-label" for="value">{t("admin.value")}</label>
          <input class="field-input" id="value" name="value" required />
        </div>
        <div style="grid-column:1 / -1;">
          <button type="submit" class="btn-primary">{t("admin.add")}</button>
        </div>
      </form>

      <div style="margin-top:32px; display:flex; flex-direction:column; gap:12px;">
        {(rows as any[]).map((r) => (
          <div class="card" style="padding:16px 20px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
            <div style="min-width:170px;">
              <div style="font-family:'Space Grotesk'; font-weight:600; font-size:14px;">{r.label}</div>
              <div style="font-size:11.5px; color:var(--text-muted); margin-top:3px;">
                {r.season_label ?? "—"} &middot; {r.kind} &middot; {r.visible_to}
              </div>
            </div>
            <div style="flex:1; min-width:220px; font-size:13px; color:var(--text-secondary); word-break:break-all;">
              {r.value}
            </div>
            <form method="POST" action="/api/team-info/save" onsubmit="return confirm('Delete?')">
              <input type="hidden" name="action" value="delete" />
              <input type="hidden" name="id" value={r.id} />
              <button type="submit" class="btn-ghost" style="font-size:12.5px;">{t("admin.delete")}</button>
            </form>
          </div>
        ))}
        {rows.length === 0 && <p style="color:var(--text-muted); font-size:14px;">{t("info.empty")}</p>}
      </div>
    </div>
  </div>
</BaseLayout>
