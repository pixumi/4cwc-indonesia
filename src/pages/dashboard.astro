---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import AdminSidebar from "../components/AdminSidebar.astro";
import LangSwitch from "../components/LangSwitch.astro";
import { formatDateTime } from "../lib/i18n";

const db = env.DB;
const user = Astro.locals.user!;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

const activeSeason = await db
  .prepare("SELECT id, year, label FROM seasons ORDER BY year DESC LIMIT 1")
  .first<{ id: number; year: number; label: string }>();

const roster = activeSeason
  ? (
      await db
        .prepare(
          `SELECT p.username as username, re.status as status, re.position as position,
                  re.is_captain as is_captain
           FROM roster_entries re JOIN players p ON p.id = re.player_id
           WHERE re.season_id = ?1 AND re.published = 1
           ORDER BY re.is_captain DESC, re.position ASC`,
        )
        .bind(activeSeason.id)
        .all()
    ).results ?? []
  : [];

const starters = (roster as any[]).filter((r) => r.status === "starter");
const substitutes = (roster as any[]).filter((r) => r.status === "substitute");

// --- Jadwal Pertandingan ---
const matches = activeSeason
  ? ((
      await db
        .prepare(
          `SELECT id, round, opponent, scheduled_at, status, score_us, score_them, mp_link, notes
           FROM matches WHERE season_id = ?1
           ORDER BY sort_order ASC, COALESCE(scheduled_at, '9999') ASC, id ASC`,
        )
        .bind(activeSeason.id)
        .all()
    ).results ?? [])
  : [];

// --- Info Tim (admins see admin-only entries too) ---
const infoVisibility = user.role === "admin" ? ["roster", "admin"] : ["roster"];
const teamInfo = (
  await db
    .prepare(
      `SELECT id, kind, label, value, visible_to FROM team_info
       WHERE (season_id IS NULL ${activeSeason ? "OR season_id = ?1" : ""})
         AND visible_to IN (${infoVisibility.map((_, i) => `?${i + (activeSeason ? 2 : 1)}`).join(", ")})
       ORDER BY sort_order ASC, id ASC`,
    )
    .bind(...(activeSeason ? [activeSeason.id, ...infoVisibility] : infoVisibility))
    .all()
).results ?? [];

const statusLabel: Record<string, string> = {
  scheduled: t("match.upcoming"),
  live: t("match.live"),
  done: t("match.done"),
};
const statusBadge: Record<string, string> = {
  scheduled: "badge-muted",
  live: "badge-violet",
  done: "badge-gold",
};
---

<BaseLayout title="Team Dashboard">
  <div style="display:flex; width:100%;">
    <AdminSidebar active="dashboard" role={user.role} displayName={user.displayName} />

    <div style="flex:1; padding:44px 56px 64px 56px; max-width:1160px;">
      <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px;">
        <div>
          <h1 style="font-size:27px; font-weight:600;">{t("dash.welcome")} {user.displayName}</h1>
          <p style="margin-top:8px; font-size:14px; color:var(--text-muted);">
            {activeSeason ? activeSeason.label : t("dash.noSeason")} &middot; Tim Indonesia
          </p>
        </div>
        <div style="display:flex; align-items:center; gap:14px;">
          <LangSwitch />
          <div class="badge badge-violet" style="padding:7px 14px;">
            <svg width="12" height="12" viewBox="0 0 20 20" fill="none">
              <rect x="4" y="9" width="12" height="8.5" rx="1.8" stroke="currentColor" stroke-width="1.8" />
              <path d="M6.5 9V6.5C6.5 4.5 8 3 10 3C12 3 13.5 4.5 13.5 6.5V9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            {t("dash.private")}
          </div>
        </div>
      </div>

      <!-- Roster -->
      <div style="margin-top:36px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px;">
          <h2 style="font-size:18px; font-weight:600;">{t("dash.roster.title")} {activeSeason?.year ?? ""}</h2>
          {substitutes.length > 0 && (
            <span style="font-size:12.5px; color:var(--text-muted);">
              +{substitutes.length} {t("dash.roster.subs")}
            </span>
          )}
        </div>

        {starters.length === 0 ? (
          <p style="margin-top:18px; color:var(--text-muted); font-size:14px;">{t("dash.roster.empty")}</p>
        ) : (
          <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:18px; margin-top:18px;">
            {starters.map((p: any) => (
              <div class="card" style="padding:18px; display:flex; align-items:center; gap:13px;">
                <div class="avatar" style="width:42px;height:42px;font-size:15px;">
                  {p.username.charAt(0).toUpperCase()}
                </div>
                <div style="flex:1;">
                  <div style="font-family:'Space Grotesk'; font-weight:600; font-size:14.5px;">{p.username}</div>
                  <div style="font-size:11.5px; color:var(--text-muted); margin-top:2px;">
                    {t("dash.position")} #{p.position}
                  </div>
                </div>
                <span class={`badge ${p.is_captain === 1 ? "badge-gold" : "badge-muted"}`}>
                  {p.is_captain === 1 ? t("players.captain") : t("dash.starter")}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Jadwal Pertandingan -->
      <div style="margin-top:44px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px;">
          <h2 style="font-size:18px; font-weight:600;">{t("match.title")}</h2>
          {user.role === "admin" && (
            <a href="/admin/matches" style="font-size:13px; font-weight:600;">{t("admin.matches.title")} &rarr;</a>
          )}
        </div>

        {matches.length === 0 ? (
          <p style="margin-top:18px; color:var(--text-muted); font-size:14px;">{t("match.empty")}</p>
        ) : (
          <div style="display:flex; flex-direction:column; gap:12px; margin-top:18px;">
            {(matches as any[]).map((m) => (
              <div class="card" style="padding:18px 20px; display:flex; align-items:center; gap:18px; flex-wrap:wrap;">
                <div style="min-width:120px;">
                  <div style="font-family:'Space Grotesk'; font-weight:600; font-size:14px;">{m.round}</div>
                  <div style="font-size:11.5px; color:var(--text-muted); margin-top:3px;">
                    {formatDateTime(m.scheduled_at, lang) ?? t("match.tbd")}
                  </div>
                </div>
                <div style="flex:1; min-width:200px; display:flex; align-items:center; gap:10px;">
                  <span style="font-family:'Space Grotesk'; font-weight:600; font-size:15px;">Indonesia</span>
                  <span style="font-size:12px; color:var(--text-muted);">{t("match.vs")}</span>
                  <span style="font-family:'Space Grotesk'; font-weight:600; font-size:15px;">{m.opponent}</span>
                </div>
                {m.status === "done" && m.score_us !== null && m.score_them !== null && (
                  <div class="display" style="font-size:18px; font-weight:700; letter-spacing:0.02em;">
                    <span style={m.score_us > m.score_them ? "color:var(--gold);" : ""}>{m.score_us}</span>
                    <span style="color:var(--text-muted);"> – </span>
                    <span style={m.score_them > m.score_us ? "color:var(--gold);" : ""}>{m.score_them}</span>
                  </div>
                )}
                <span class={`badge ${statusBadge[m.status] ?? "badge-muted"}`}>
                  {statusLabel[m.status] ?? m.status}
                </span>
                {m.mp_link && (
                  <a href={m.mp_link} target="_blank" rel="noopener noreferrer" style="font-size:12.5px; font-weight:600;">
                    {t("match.watch")} &rarr;
                  </a>
                )}
                {m.notes && (
                  <div style="flex-basis:100%; font-size:12.5px; color:var(--text-muted); line-height:1.55;">
                    {m.notes}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Info Tim -->
      <div style="margin-top:44px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px;">
          <h2 style="font-size:18px; font-weight:600;">{t("info.title")}</h2>
          {user.role === "admin" && (
            <a href="/admin/team-info" style="font-size:13px; font-weight:600;">{t("admin.info.title")} &rarr;</a>
          )}
        </div>

        {teamInfo.length === 0 ? (
          <p style="margin-top:18px; color:var(--text-muted); font-size:14px;">{t("info.empty")}</p>
        ) : (
          <div style="display:grid; grid-template-columns:repeat(2, 1fr); gap:16px; margin-top:18px;">
            {(teamInfo as any[]).map((row) => (
              <div class="card" style="padding:18px 20px;">
                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                  <div style="font-family:'Space Grotesk'; font-weight:600; font-size:14px;">{row.label}</div>
                  {row.visible_to === "admin" && <span class="badge badge-muted">admin</span>}
                </div>
                {row.kind === "link" ? (
                  <a
                    href={row.value}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="display:inline-block; margin-top:8px; font-size:13px; font-weight:600; word-break:break-all;"
                  >
                    {row.value}
                  </a>
                ) : (
                  <div style="margin-top:8px; font-size:13.5px; color:var(--text-secondary); line-height:1.6; white-space:pre-wrap;">
                    {row.value}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
