---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import AdminSidebar from "../components/AdminSidebar.astro";

const db = env.DB;
const user = Astro.locals.user!;

const activeSeason = await db
  .prepare("SELECT id, year, label FROM seasons ORDER BY year DESC LIMIT 1")
  .first<{ id: number; year: number; label: string }>();

const roster = activeSeason
  ? (
      await db
        .prepare(
          `SELECT p.username as username, re.status as status, re.position as position
           FROM roster_entries re JOIN players p ON p.id = re.player_id
           WHERE re.season_id = ?1 AND re.published = 1 ORDER BY re.position ASC`,
        )
        .bind(activeSeason.id)
        .all()
    ).results ?? []
  : [];

const starters = (roster as any[]).filter((r) => r.status === "starter");
const substitutes = (roster as any[]).filter((r) => r.status === "substitute");
---

<BaseLayout title="Team Dashboard">
  <div style="display:flex; width:100%;">
    <AdminSidebar active="dashboard" role={user.role} displayName={user.displayName} />

    <div style="flex:1; padding:44px 56px 64px 56px; max-width:1160px;">
      <div style="display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:16px;">
        <div>
          <h1 style="font-size:27px; font-weight:600;">Selamat datang kembali, {user.displayName}</h1>
          <p style="margin-top:8px; font-size:14px; color:var(--text-muted);">
            {activeSeason ? activeSeason.label : "Belum ada musim aktif"} &middot; Tim Indonesia
          </p>
        </div>
        <div class="badge badge-violet" style="padding:7px 14px;">
          <svg width="12" height="12" viewBox="0 0 20 20" fill="none">
            <rect x="4" y="9" width="12" height="8.5" rx="1.8" stroke="currentColor" stroke-width="1.8" />
            <path d="M6.5 9V6.5C6.5 4.5 8 3 10 3C12 3 13.5 4.5 13.5 6.5V9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
          Privat &mdash; Hanya Roster Tim
        </div>
      </div>

      <div style="margin-top:36px;">
        <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px;">
          <h2 style="font-size:18px; font-weight:600;">Roster Resmi {activeSeason?.year ?? ""}</h2>
          {substitutes.length > 0 && (
            <span style="font-size:12.5px; color:var(--text-muted);">+{substitutes.length} pemain cadangan</span>
          )}
        </div>

        {starters.length === 0 ? (
          <p style="margin-top:18px; color:var(--text-muted); font-size:14px;">
            Roster musim ini belum dipublikasikan oleh admin.
          </p>
        ) : (
          <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:18px; margin-top:18px;">
            {starters.map((p: any) => (
              <div class="card" style="padding:18px; display:flex; align-items:center; gap:13px;">
                <div class="avatar" style="width:42px;height:42px;font-size:15px;">
                  {p.username.charAt(0).toUpperCase()}
                </div>
                <div style="flex:1;">
                  <div style="font-family:'Space Grotesk'; font-weight:600; font-size:14.5px;">{p.username}</div>
                  <div style="font-size:11.5px; color:var(--text-muted); margin-top:2px;">Posisi #{p.position}</div>
                </div>
                <span class="badge badge-gold">Starter</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
