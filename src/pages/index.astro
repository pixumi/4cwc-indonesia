---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicNav from "../components/PublicNav.astro";
import PlayerCard from "../components/PlayerCard.astro";
import { formatResult } from "../lib/i18n";

const db = env.DB;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

const seasons =
  (await db.prepare("SELECT id, year, label, result FROM seasons ORDER BY year DESC").all()).results ?? [];
const totalSeasons = seasons.length;

const playerCountRow = await db.prepare("SELECT COUNT(DISTINCT player_id) as c FROM roster_entries").first<{
  c: number;
}>();
const totalPlayers = playerCountRow?.c ?? 0;

const highlightSeason = (seasons as any[]).find((s) => s.result) ?? null;
const highlightRoster = highlightSeason
  ? ((
      await db
        .prepare(
          `SELECT p.username as username, p.osu_id as osu_id, p.cover_url as cover_url,
                  re.is_captain as is_captain
           FROM roster_entries re
           JOIN players p ON p.id = re.player_id
           WHERE re.season_id = ?1 AND re.published = 1
           ORDER BY re.is_captain DESC, re.position ASC, p.username ASC`,
        )
        .bind(highlightSeason.id)
        .all()
    ).results ?? [])
  : [];
---

<BaseLayout title="Beranda">
  <PublicNav active="home" />

  <div class="page-pad" style="position:relative; overflow:hidden; padding-top:clamp(48px, 9vw, 96px); padding-bottom:clamp(36px, 6vw, 64px);">
    <div
      style="position:absolute; width:340px; height:340px; border-radius:50%; background:var(--gold); opacity:0.10; filter:blur(90px); top:-120px; right:120px;"
    >
    </div>
    <div
      style="position:absolute; width:280px; height:280px; border-radius:50%; background:var(--violet); opacity:0.16; filter:blur(90px); top:60px; right:-40px;"
    >
    </div>
    <div style="position:relative; max-width:900px;">
      <h1 style="font-size:clamp(30px, 6.2vw, 56px); line-height:1.12; font-weight:600; letter-spacing:-0.01em;">
        <span
          style="background:linear-gradient(120deg, var(--gold), var(--violet)); -webkit-background-clip:text; background-clip:text; color:transparent;"
          >4 Digit Catch World Cup</span
        ><br />
        Indonesia Team
      </h1>
      <div style="display:flex; align-items:center; gap:36px; margin-top:36px; flex-wrap:wrap;">
        <a href="/players" class="btn-primary">{t("home.cta.players")}</a>

        <div style="display:flex; align-items:center; gap:28px;">
          <div>
            <div class="display" style="font-size:26px; font-weight:700; color:var(--gold); line-height:1.1;">
              {totalSeasons}
            </div>
            <div style="font-size:11.5px; color:var(--text-muted); margin-top:3px;">{t("home.stat.seasonsShort")}</div>
          </div>
          <div style="width:1px; height:34px; background:var(--border-subtle);"></div>
          <div>
            <div class="display" style="font-size:26px; font-weight:700; color:var(--violet); line-height:1.1;">
              {totalPlayers}
            </div>
            <div style="font-size:11.5px; color:var(--text-muted); margin-top:3px;">{t("home.stat.playersShort")}</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="page-pad" style="padding-top:72px; padding-bottom:72px;">
    <h2 style="font-size:clamp(20px, 3.2vw, 26px); font-weight:600;">{t("home.seasons.heading")}</h2>
    <p style="margin-top:8px; font-size:14.5px; color:var(--text-muted);">{t("home.seasons.sub")}</p>
    <div style="display:flex; gap:20px; margin-top:32px; flex-wrap:wrap;">
      {
        (seasons as any[]).map((s) => (
          <div class="card" style={`flex:1; min-width:180px; padding:26px; ${s.result ? "border-color:oklch(0.80 0.13 85 / 0.35);" : ""}`}>
            <div class="display" style={`font-size:22px; font-weight:700; color:${s.result ? "var(--gold)" : "var(--text-secondary)"};`}>
              {s.year}
            </div>
            <div style="margin-top:14px;">
              <span class={`badge ${s.result ? "badge-gold" : "badge-muted"}`}>{formatResult(s.result, lang) ?? t("home.season.soon")}</span>
            </div>
          </div>
        ))
      }
      {seasons.length === 0 && <p style="color:var(--text-muted); font-size:14px;">{t("home.seasons.empty")}</p>}
    </div>
  </div>

  <div id="roster-highlight" class="page-pad" style="padding-top:0; padding-bottom:80px;">
    <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px;">
      <div>
        <h2 style="font-size:clamp(20px, 3.2vw, 26px); font-weight:600;">{t("home.highlight.heading")} — {highlightSeason?.label ?? "—"}</h2>
      </div>
      <a href="/players" style="font-size:14px; font-weight:600;">{t("home.viewAll")} &rarr;</a>
    </div>
    <div class="roster-grid" style="margin-top:32px;">
      {
        (highlightRoster as any[]).map((p) => (
          <PlayerCard
            username={p.username}
            osuId={p.osu_id ?? null}
            coverUrl={p.cover_url ?? null}
            isCaptain={p.is_captain === 1}
            captainLabel={t("players.captain")}
          />
        ))
      }
    </div>
  </div>

  <div
    class="page-pad"
    style="display:flex; align-items:center; justify-content:space-between; padding-top:32px; padding-bottom:32px; border-top:1px solid var(--border-faint); flex-wrap:wrap; gap:16px;"
  >
    <div style="font-size:13px; color:var(--text-muted);">
      {t("footer.tagline")}
    </div>
    <div style="display:flex; gap:28px;">
      <a href="/players" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.players")}</a>
      <a href="/admin/login" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.login")}</a>
    </div>
  </div>
</BaseLayout>
