---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicNav from "../components/PublicNav.astro";
import { formatDateTime } from "../lib/i18n";

const db = env.DB;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

const seasons =
  (
    await db
      .prepare("SELECT id, year, label, result, result_note, seed, record, source_url FROM seasons ORDER BY year DESC")
      .all()
  ).results ?? [];

const rosterBySeasonId: Record<number, any[]> = {};
const matchesBySeasonId: Record<number, any[]> = {};

for (const s of seasons as any[]) {
  rosterBySeasonId[s.id] =
    (
      await db
        .prepare(
          `SELECT p.username as username, re.is_captain as is_captain, re.status as status
           FROM roster_entries re
           JOIN players p ON p.id = re.player_id
           WHERE re.season_id = ?1 AND re.published = 1
           ORDER BY re.is_captain DESC, re.position ASC, p.username ASC`,
        )
        .bind(s.id)
        .all()
    ).results ?? [];

  matchesBySeasonId[s.id] =
    (
      await db
        .prepare(
          `SELECT round, opponent, scheduled_at, score_us, score_them, mp_link, notes
           FROM matches WHERE season_id = ?1
           ORDER BY sort_order ASC, COALESCE(scheduled_at, '9999') ASC, id ASC`,
        )
        .bind(s.id)
        .all()
    ).results ?? [];
}

/** Won / lost / walkover-win, from Indonesia's point of view. */
function outcome(m: any): "win" | "loss" | "wo" {
  if (m.score_us === null || m.score_them === null) return "wo";
  return m.score_us > m.score_them ? "win" : "loss";
}
---

<BaseLayout title={t("players.title")}>
  <PublicNav active="players" />

  <div style="padding:64px 80px 32px 80px;">
    <h1 style="font-size:38px; font-weight:600; letter-spacing:-0.01em;">{t("players.title")}</h1>
    <p style="margin-top:12px; font-size:15.5px; color:var(--text-secondary); max-width:620px; line-height:1.6;">
      {t("players.lede")}
    </p>
  </div>

  <div style="display:flex; gap:12px; padding:0 80px 40px 80px; flex-wrap:wrap;">
    <a href="#" class="pill active">{t("players.all")}</a>
    {
      (seasons as any[]).map((s) => (
        <a href={`#season-${s.id}`} class={`pill ${rosterBySeasonId[s.id]?.length ? "" : "soon"}`}>
          {s.year}
        </a>
      ))
    }
  </div>

  {
    (seasons as any[]).map((s) => (
      <div id={`season-${s.id}`} style="padding:0 80px 56px 80px;">
        <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
          <h2 style="font-size:22px; font-weight:600;">{s.label}</h2>
          {s.result && <span class="badge badge-gold">{s.result}</span>}
          {s.record && (
            <span class="badge badge-muted">
              {t("players.record")} {s.record}
            </span>
          )}
          {s.seed && (
            <span style="font-size:12.5px; color:var(--text-muted);">
              {t("players.seed")}: {s.seed}
            </span>
          )}
        </div>

        {s.result_note && (
          <p style="margin-top:8px; font-size:13.5px; color:var(--text-muted); line-height:1.6; max-width:720px;">
            {s.result_note}
          </p>
        )}

        {rosterBySeasonId[s.id]?.length ? (
          <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-top:24px;">
            {rosterBySeasonId[s.id].map((p: any) => (
              <div
                class="card"
                style={`padding:20px; display:flex; align-items:center; gap:14px; ${p.is_captain ? "border-color:oklch(0.80 0.13 85 / 0.45);" : ""}`}
              >
                <div class="avatar" style="width:46px;height:46px;font-size:17px;">
                  {p.username.charAt(0).toUpperCase()}
                </div>
                <div style="flex:1; min-width:0;">
                  <div style="font-family:'Space Grotesk'; font-weight:600; font-size:15px;">{p.username}</div>
                  <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                    {t("home.playerLabel")} &middot; {t("players.activeIn")} {s.year}
                  </div>
                </div>
                {p.is_captain === 1 && (
                  <span class="badge badge-gold" style="flex-shrink:0;">
                    <svg width="11" height="11" viewBox="0 0 576 512" fill="currentColor" aria-hidden="true">
                      <path d="M309 106c11.4-7 19-19.7 19-34c0-22.1-17.9-40-40-40s-40 17.9-40 40c0 14.4 7.6 27 19 34L209.7 220.6c-9.1 18.2-32.7 23.4-48.6 10.7L72 160c5-6.7 8-15 8-24c0-22.1-17.9-40-40-40S0 113.9 0 136s17.9 40 40 40c.2 0 .5 0 .7 0L86.4 427.4c5.5 30.4 32 52.6 63 52.6l277.2 0c30.9 0 57.4-22.1 63-52.6L535.3 176c.2 0 .5 0 .7 0c22.1 0 40-17.9 40-40s-17.9-40-40-40s-40 17.9-40 40c0 9 3 17.3 8 24l-89.1 71.3c-15.9 12.7-39.5 7.5-48.6-10.7L309 106z" />
                    </svg>
                    {t("players.captain")}
                  </span>
                )}
              </div>
            ))}
          </div>
        ) : (
          <div
            class="card"
            style="padding:40px; margin-top:24px; border-style:dashed; border-color:var(--border-subtle);"
          >
            <div style="font-size:14px; color:var(--text-muted); line-height:1.6; max-width:560px;">
              {t("players.pendingTitle")}
            </div>
          </div>
        )}

        {/* Match history */}
        <h3 style="font-size:15px; font-weight:600; margin-top:34px;">{t("players.matchHistory")}</h3>
        {matchesBySeasonId[s.id]?.length ? (
          <div style="margin-top:14px; overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:13.5px; min-width:640px;">
              <thead>
                <tr style="text-align:left; color:var(--text-muted); font-size:12px;">
                  <th style="padding:8px 12px 8px 0; font-weight:600;">{t("players.round")}</th>
                  <th style="padding:8px 12px; font-weight:600;">{t("players.opponent")}</th>
                  <th style="padding:8px 12px; font-weight:600;">{t("players.score")}</th>
                  <th style="padding:8px 12px; font-weight:600;">{t("admin.datetime")}</th>
                  <th style="padding:8px 0 8px 12px; font-weight:600;">{t("players.mp")}</th>
                </tr>
              </thead>
              <tbody>
                {matchesBySeasonId[s.id].map((m: any) => {
                  const o = outcome(m);
                  return (
                    <tr style="border-top:1px solid var(--border-faint);">
                      <td style="padding:11px 12px 11px 0; font-weight:600;">{m.round}</td>
                      <td style="padding:11px 12px; color:var(--text-secondary);">{m.opponent}</td>
                      <td style="padding:11px 12px;">
                        {o === "wo" ? (
                          <span class="badge badge-gold">{t("players.walkover")}</span>
                        ) : (
                          <span
                            class="display"
                            style={`font-weight:700; letter-spacing:0.02em; color:${o === "win" ? "var(--gold)" : "var(--text-muted)"};`}
                          >
                            {m.score_us}&ndash;{m.score_them}
                          </span>
                        )}
                        <span
                          style={`margin-left:9px; font-size:11.5px; color:${o === "loss" ? "var(--text-muted)" : "var(--gold-dim)"};`}
                        >
                          {o === "loss" ? t("players.loss") : t("players.win")}
                        </span>
                      </td>
                      <td style="padding:11px 12px; color:var(--text-muted); font-size:12.5px; white-space:nowrap;">
                        {formatDateTime(m.scheduled_at, lang) ?? "—"}
                      </td>
                      <td style="padding:11px 0 11px 12px;">
                        {m.mp_link ? (
                          <a href={m.mp_link} target="_blank" rel="noopener noreferrer" style="font-weight:600; font-size:12.5px;">
                            osu! &rarr;
                          </a>
                        ) : (
                          <span style="color:var(--text-muted); font-size:12.5px;">&mdash;</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        ) : (
          <p style="margin-top:12px; font-size:13.5px; color:var(--text-muted);">{t("players.noMatches")}</p>
        )}

        {s.source_url && (
          <p style="margin-top:14px; font-size:12px; color:var(--text-muted);">
            {t("players.source")}:{" "}
            <a href={s.source_url} target="_blank" rel="noopener noreferrer">
              {s.source_url}
            </a>
          </p>
        )}
      </div>
    ))
  }

  {seasons.length === 0 && <div style="padding:0 80px 80px 80px; color:var(--text-muted);">{t("players.noSeasons")}</div>}

  <div
    style="display:flex; align-items:center; justify-content:space-between; padding:32px 80px; border-top:1px solid var(--border-faint); flex-wrap:wrap; gap:16px;"
  >
    <div style="font-size:13px; color:var(--text-muted);">{t("footer.tagline")}</div>
    <div style="display:flex; gap:28px;">
      <a href="/" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.home")}</a>
      <a href="/admin/login" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.login")}</a>
    </div>
  </div>
</BaseLayout>
