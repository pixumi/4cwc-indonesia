---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicNav from "../components/PublicNav.astro";
import PlayerCard from "../components/PlayerCard.astro";
import MatchRow from "../components/MatchRow.astro";

const db = env.DB;
const t = Astro.locals.t;
const lang = Astro.locals.lang;

const seasons =
  (
    await db
      .prepare("SELECT id, year, label, result, result_note, seed, record, source_url FROM seasons ORDER BY year DESC")
      .all()
  ).results ?? [];

const rosterBySeasonId: Record<number, any[]> = {};
const matchesBySeasonId: Record<number, any[]> = {};

for (const s of seasons as any[]) {
  rosterBySeasonId[s.id] =
    (
      await db
        .prepare(
          `SELECT p.username as username, p.osu_id as osu_id, p.cover_url as cover_url,
                  re.is_captain as is_captain
           FROM roster_entries re
           JOIN players p ON p.id = re.player_id
           WHERE re.season_id = ?1 AND re.published = 1
           ORDER BY re.is_captain DESC, re.position ASC, p.username ASC`,
        )
        .bind(s.id)
        .all()
    ).results ?? [];

  matchesBySeasonId[s.id] =
    (
      await db
        .prepare(
          `SELECT round, bracket, indo_side, opponent, scheduled_at, score_us, score_them, mp_link, notes
           FROM matches WHERE season_id = ?1
           ORDER BY sort_order ASC, COALESCE(scheduled_at, '9999') ASC, id ASC`,
        )
        .bind(s.id)
        .all()
    ).results ?? [];
}
---

<BaseLayout title={t("players.title")}>
  <PublicNav active="players" />

  <div style="padding:64px 80px 32px 80px;">
    <h1 style="font-size:38px; font-weight:600; letter-spacing:-0.01em;">{t("players.title")}</h1>
    <p style="margin-top:12px; font-size:15.5px; color:var(--text-secondary); max-width:620px; line-height:1.6;">
      {t("players.lede")}
    </p>
  </div>

  <div id="year-filter" style="display:flex; gap:12px; padding:0 80px 40px 80px; flex-wrap:wrap;">
    <button type="button" class="pill active" data-year="all">{t("players.all")}</button>
    {
      (seasons as any[]).map((s) => (
        <button type="button" class={`pill ${rosterBySeasonId[s.id]?.length ? "" : "soon"}`} data-year={s.year}>
          {s.year}
        </button>
      ))
    }
  </div>

  {
    (seasons as any[]).map((s) => (
      <section class="season" data-year={s.year} id={`season-${s.year}`} style="padding:0 80px 56px 80px;">
        <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
          <h2 style="font-size:22px; font-weight:600;">{s.label}</h2>
          {s.result && <span class="badge badge-gold">{s.result}</span>}
          {s.record && <span class="badge badge-muted">{t("players.record")} {s.record}</span>}
          {s.seed && (
            <span style="font-size:12.5px; color:var(--text-muted);">
              {t("players.seed")}: {s.seed}
            </span>
          )}
        </div>

        {s.result_note && (
          <p style="margin-top:8px; font-size:13.5px; color:var(--text-muted); line-height:1.6; max-width:720px;">
            {s.result_note}
          </p>
        )}

        {rosterBySeasonId[s.id]?.length ? (
          <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:18px; margin-top:24px;">
            {rosterBySeasonId[s.id].map((p: any) => (
              <PlayerCard
                username={p.username}
                osuId={p.osu_id ?? null}
                coverUrl={p.cover_url ?? null}
                isCaptain={p.is_captain === 1}
                subtitle={`${t("home.playerLabel")} · ${t("players.activeIn")} ${s.year}`}
                captainLabel={t("players.captain")}
              />
            ))}
          </div>
        ) : (
          <div class="card" style="padding:40px; margin-top:24px; border-style:dashed; border-color:var(--border-subtle);">
            <div style="font-size:14px; color:var(--text-muted); line-height:1.6; max-width:560px;">
              {t("players.pendingTitle")}
            </div>
          </div>
        )}

        <h3 style="font-size:15px; font-weight:600; margin-top:34px; margin-bottom:14px;">{t("players.matchHistory")}</h3>
        {matchesBySeasonId[s.id]?.length ? (
          <div>
            <div class="match-head">
              <span></span>
              <span class="match-head-teams">
                <span>{t("match.teamA")}</span>
                <span>{t("match.teamB")}</span>
              </span>
              <span></span>
            </div>
            {matchesBySeasonId[s.id].map((m: any) => (
              <MatchRow
                round={m.round}
                bracket={m.bracket ?? null}
                indoSide={m.indo_side === 2 ? 2 : 1}
                opponent={m.opponent}
                scheduledAt={m.scheduled_at}
                scoreUs={m.score_us}
                scoreThem={m.score_them}
                mpLink={m.mp_link}
                notes={m.notes}
                lang={lang}
                t={t}
              />
            ))}
          </div>
        ) : (
          <p style="font-size:13.5px; color:var(--text-muted);">{t("players.noMatches")}</p>
        )}

        {s.source_url && (
          <p style="margin-top:14px; font-size:12px; color:var(--text-muted);">
            {t("players.source")}:{" "}
            <a href={s.source_url} target="_blank" rel="noopener noreferrer">{s.source_url}</a>
          </p>
        )}
      </section>
    ))
  }

  {seasons.length === 0 && <div style="padding:0 80px 80px 80px; color:var(--text-muted);">{t("players.noSeasons")}</div>}

  <div
    style="display:flex; align-items:center; justify-content:space-between; padding:32px 80px; border-top:1px solid var(--border-faint); flex-wrap:wrap; gap:16px;"
  >
    <div style="font-size:13px; color:var(--text-muted);">{t("footer.tagline")}</div>
    <div style="display:flex; gap:28px;">
      <a href="/" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.home")}</a>
      <a href="/admin/login" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.login")}</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* The pills are buttons now (they filter rather than jump), so they need
     the anchor styling that .pill assumed. */
  #year-filter .pill {
    font-family: "Manrope", sans-serif;
    cursor: pointer;
  }
  .season[hidden] { display: none; }

  /* Column captions above the scoreline, mirroring the source bracket tables. */
  .match-head {
    display: grid;
    grid-template-columns: 240px 1fr 90px;
    gap: 18px;
    padding: 0 16px 8px 16px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .match-head-teams { display: flex; justify-content: center; gap: 16px; }
  .match-head-teams > span { flex: 1; }
  .match-head-teams > span:first-child { text-align: right; }
  .match-head-teams > span:last-child { text-align: left; }
  @media (max-width: 860px) { .match-head { display: none; } }
</style>

<script>
  // Year filter: "Semua" shows every season, a year shows only that one.
  // Progressive enhancement — with JS off, every season stays visible.
  const bar = document.getElementById("year-filter");
  const sections = Array.from(document.querySelectorAll<HTMLElement>("section.season"));

  if (bar) {
    const pills = Array.from(bar.querySelectorAll<HTMLElement>(".pill"));

    const apply = (year: string) => {
      for (const el of sections) {
        el.hidden = year !== "all" && el.dataset.year !== year;
      }
      for (const b of pills) {
        b.classList.toggle("active", b.dataset.year === year);
      }
      const url = new URL(window.location.href);
      if (year === "all") url.searchParams.delete("year");
      else url.searchParams.set("year", year);
      history.replaceState(null, "", url.pathname + url.search);
    };

    bar.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      const btn = target?.closest<HTMLElement>(".pill");
      if (btn?.dataset.year) apply(btn.dataset.year);
    });

    // Honour ?year= on load so a filtered view can be linked to.
    const initial = new URL(window.location.href).searchParams.get("year");
    if (initial && sections.some((sec) => sec.dataset.year === initial)) apply(initial);
  }
</script>
