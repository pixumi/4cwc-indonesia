---
import { env } from "cloudflare:workers";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicNav from "../components/PublicNav.astro";

const db = env.DB;
const t = Astro.locals.t;
const seasons =
  (await db.prepare("SELECT id, year, label, result, result_note FROM seasons ORDER BY year DESC").all()).results ??
  [];

const rosterBySeasonId: Record<number, any[]> = {};
for (const s of seasons as any[]) {
  const rows =
    (
      await db
        .prepare(
          `SELECT p.username as username FROM roster_entries re
           JOIN players p ON p.id = re.player_id
           WHERE re.season_id = ?1 AND re.published = 1
           ORDER BY re.position ASC, p.username ASC`,
        )
        .bind(s.id)
        .all()
    ).results ?? [];
  rosterBySeasonId[s.id] = rows;
}
---

<BaseLayout title="Player History">
  <PublicNav active="players" />

  <div style="padding:64px 80px 32px 80px;">
    <h1 style="font-size:38px; font-weight:600; letter-spacing:-0.01em;">{t("players.title")}</h1>
    <p style="margin-top:12px; font-size:15.5px; color:var(--text-secondary); max-width:620px; line-height:1.6;">
      {t("players.lede")}
    </p>
  </div>

  <div style="display:flex; gap:12px; padding:0 80px 40px 80px; flex-wrap:wrap;">
    <a href="#" class="pill active">{t("players.all")}</a>
    {
      (seasons as any[]).map((s) => (
        <a href={`#season-${s.id}`} class={`pill ${rosterBySeasonId[s.id]?.length ? "" : "soon"}`}>
          {s.year}
        </a>
      ))
    }
  </div>

  {
    (seasons as any[]).map((s) => (
      <div id={`season-${s.id}`} style="padding:0 80px 48px 80px;">
        {rosterBySeasonId[s.id]?.length ? (
          <>
            <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
              <h2 style="font-size:22px; font-weight:600;">{s.label}</h2>
              <span class="badge badge-gold">{s.result}</span>
            </div>
            {s.result_note && <p style="margin-top:8px; font-size:13px; color:var(--text-muted);">{s.result_note}</p>}
            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; margin-top:28px;">
              {rosterBySeasonId[s.id].map((p: any) => (
                <div class="card" style="padding:20px; display:flex; align-items:center; gap:14px;">
                  <div class="avatar" style="width:46px;height:46px;font-size:17px;">
                    {p.username.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <div style="font-family:'Space Grotesk'; font-weight:600; font-size:15px;">{p.username}</div>
                    <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                      {t("home.playerLabel")} &middot; {t("players.activeIn")} {s.year}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div
            class="card"
            style="padding:48px; display:flex; align-items:center; gap:24px; border-style:dashed; border-color:var(--border-subtle); flex-wrap:wrap;"
          >
            <div style="width:56px; height:56px; border-radius:14px; background:var(--bg-panel-hover); display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--text-muted);">
              <svg width="24" height="24" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.5" />
                <path d="M10 6V10L12.6 11.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <div>
              <div style="font-family:'Space Grotesk'; font-weight:600; font-size:16px;">{s.label}</div>
              <div style="font-size:14px; color:var(--text-muted); margin-top:4px; line-height:1.6; max-width:560px;">
                {t("players.pendingTitle")}
              </div>
            </div>
          </div>
        )}
      </div>
    ))
  }

  {seasons.length === 0 && <div style="padding:0 80px 80px 80px; color:var(--text-muted);">{t("players.noSeasons")}</div>}

  <div
    style="display:flex; align-items:center; justify-content:space-between; padding:32px 80px; border-top:1px solid var(--border-faint); flex-wrap:wrap; gap:16px;"
  >
    <div style="font-size:13px; color:var(--text-muted);">
      {t("footer.tagline")}
    </div>
    <div style="display:flex; gap:28px;">
      <a href="/" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.home")}</a>
      <a href="/admin/login" style="font-size:13px; color:var(--text-secondary); font-weight:600;">{t("nav.login")}</a>
    </div>
  </div>
</BaseLayout>
