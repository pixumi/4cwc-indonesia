---
// Real language switcher: links back to the current URL with ?lang=<code>.
// Middleware reads that param, stores it in the 4cwc_lang cookie, and exposes
// Astro.locals.lang / Astro.locals.t to every page.
const current = Astro.locals.lang;
const url = new URL(Astro.request.url);

function hrefFor(lang: string) {
  const u = new URL(url.toString());
  u.searchParams.set("lang", lang);
  return u.pathname + u.search;
}
---

<div class="lang-switch">
  <a
    href={hrefFor("id")}
    class={`lang-btn ${current === "id" ? "active" : ""}`}
    title="Bahasa Indonesia"
    aria-label="Bahasa Indonesia"
    aria-current={current === "id" ? "true" : undefined}
  >
    <svg width="22" height="16" viewBox="0 0 22 16" xmlns="http://www.w3.org/2000/svg">
      <clipPath id="idflag-clip"><rect width="22" height="16" rx="3"></rect></clipPath>
      <g clip-path="url(#idflag-clip)">
        <rect width="22" height="8" y="0" fill="#E0433D"></rect>
        <rect width="22" height="8" y="8" fill="#F5F5F0"></rect>
      </g>
    </svg>
  </a>
  <a
    href={hrefFor("en")}
    class={`lang-btn ${current === "en" ? "active" : ""}`}
    title="English"
    aria-label="English"
    aria-current={current === "en" ? "true" : undefined}
  >
    <svg width="22" height="16" viewBox="0 0 22 16" xmlns="http://www.w3.org/2000/svg">
      <clipPath id="ukflag-clip"><rect width="22" height="16" rx="3"></rect></clipPath>
      <g clip-path="url(#ukflag-clip)">
        <rect width="22" height="16" fill="#1B2A5E"></rect>
        <path d="M0 0L22 16M22 0L0 16" stroke="#FFFFFF" stroke-width="3.2"></path>
        <path d="M0 0L22 16M22 0L0 16" stroke="#C8313A" stroke-width="1.1"></path>
        <path d="M11 0V16M0 8H22" stroke="#FFFFFF" stroke-width="5"></path>
        <path d="M11 0V16M0 8H22" stroke="#C8313A" stroke-width="2.4"></path>
      </g>
    </svg>
  </a>
</div>
