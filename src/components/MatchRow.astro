---
import { flagUrl } from "../lib/countries";
import { formatDateTime, type Lang } from "../lib/i18n";

interface Props {
  round: string;
  bracket: "upper" | "lower" | "grand" | null;
  indoSide: 1 | 2;
  opponent: string;
  scheduledAt: string | null;
  scoreUs: number | null;
  scoreThem: number | null;
  mpLink: string | null;
  notes: string | null;
  lang: Lang;
  t: (k: string) => string;
}

const { round, bracket, indoSide, opponent, scheduledAt, scoreUs, scoreThem, mpLink, notes, lang, t } = Astro.props;

const walkover = scoreUs === null || scoreThem === null;
const won = walkover ? true : (scoreUs as number) > (scoreThem as number);

// Render teams in the order the source bracket published them (Team A / Team B),
// not winner-first — that keeps the row faithful to the wiki/wyBin tables.
const idFlag = flagUrl("Indonesia");
const oppFlag = flagUrl(opponent);
const ID = { name: "Indonesia", flag: idFlag, score: scoreUs, us: true };
const OPP = { name: opponent, flag: oppFlag, score: scoreThem, us: false };
const left = indoSide === 1 ? ID : OPP;
const right = indoSide === 1 ? OPP : ID;
const leftWon = left.us ? won : !won;
---

<div class="match-row">
  <div class="match-round">
    <span class="match-round-top">
      <span class="match-round-name">{round}</span>
      {bracket && <span class={`brk brk-${bracket}`}>{t(`bracket.${bracket}`)}</span>}
    </span>
    <span class="match-date">{formatDateTime(scheduledAt, lang) ?? "—"}</span>
  </div>

  <div class="scoreline">
    <div class="side side-left">
      <span class={`team ${left.us ? "team-us" : ""} ${leftWon ? "team-win" : ""}`}>{left.name}</span>
      {left.flag ? (
        <img class="flag" src={left.flag} width="22" height="16" alt={left.name} loading="lazy" />
      ) : (
        <span class="flag flag-none" aria-hidden="true"></span>
      )}
    </div>

    <div class="scores">
      {walkover ? (
        <span class="wbd" title={notes ?? undefined}>{t("players.walkover")}</span>
      ) : (
        <>
          <span class={`sc ${leftWon ? "sc-win" : ""}`}>{left.score}</span>
          <span class="sc-sep">–</span>
          <span class={`sc ${!leftWon ? "sc-win" : ""}`}>{right.score}</span>
        </>
      )}
    </div>

    <div class="side side-right">
      {right.flag ? (
        <img class="flag" src={right.flag} width="22" height="16" alt={right.name} loading="lazy" />
      ) : (
        <span class="flag flag-none" aria-hidden="true"></span>
      )}
      <span class={`team ${right.us ? "team-us" : ""} ${!leftWon ? "team-win" : ""}`}>{right.name}</span>
    </div>
  </div>

  <div class="match-link">
    {mpLink ? (
      <a href={mpLink} target="_blank" rel="noopener noreferrer">{t("players.mp")} &rarr;</a>
    ) : (
      <span class="no-link">&mdash;</span>
    )}
  </div>

  {notes && !walkover && <div class="match-note">{notes}</div>}
</div>

<style>
  .match-row {
    display: grid;
    grid-template-columns: 240px 1fr 90px;
    align-items: center;
    gap: 18px;
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--bg-panel);
    border: 1px solid var(--border-faint);
  }
  .match-row + .match-row { margin-top: 8px; }

  .match-round { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .match-round-top { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .match-round-name { font-family: "Space Grotesk", sans-serif; font-weight: 600; font-size: 13.5px; }
  .match-date { font-size: 11.5px; color: var(--text-muted); }

  .brk {
    font-size: 9.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
    padding: 2.5px 7px; border-radius: 999px; white-space: nowrap; line-height: 1.35;
    border: 1px solid transparent;
  }
  .brk-upper { color: oklch(0.82 0.11 200); background: oklch(0.82 0.11 200 / 0.12); border-color: oklch(0.82 0.11 200 / 0.32); }
  .brk-lower { color: oklch(0.78 0.13 30);  background: oklch(0.78 0.13 30 / 0.12);  border-color: oklch(0.78 0.13 30 / 0.32); }
  .brk-grand { color: var(--gold); background: oklch(0.8 0.13 85 / 0.14); border-color: var(--gold-dim); }

  .scoreline { display: flex; align-items: center; justify-content: center; gap: 16px; min-width: 0; }
  .side { display: flex; align-items: center; gap: 9px; flex: 1; min-width: 0; }
  .side-left { justify-content: flex-end; }
  .side-right { justify-content: flex-start; }

  .team {
    font-size: 14px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Indonesia always reads as the subject of the row; winning adds the gold. */
  .team-us { color: var(--text-primary); font-weight: 800; letter-spacing: 0.005em; }
  .team-win { color: var(--text-secondary); font-weight: 600; }
  .team-us.team-win { color: var(--text-primary); font-weight: 800; }

  .flag { border-radius: 3px; flex-shrink: 0; object-fit: cover; box-shadow: 0 0 0 1px oklch(1 0 0 / 0.12); }
  .flag-none {
    width: 22px; height: 16px; border-radius: 3px; display: inline-block;
    background: var(--bg-panel-hover); box-shadow: 0 0 0 1px oklch(1 0 0 / 0.12);
  }

  .scores {
    display: flex; align-items: baseline; gap: 7px;
    font-family: "Space Grotesk", sans-serif; font-size: 19px; font-weight: 700;
    flex-shrink: 0;
  }
  .sc { color: var(--text-muted); min-width: 14px; text-align: center; }
  .sc-win { color: var(--gold); }
  .sc-sep { color: var(--text-muted); font-size: 15px; }
  .wbd {
    font-family: "Manrope", sans-serif; font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em;
    color: var(--gold); border: 1px solid var(--gold-dim); border-radius: 999px; padding: 3px 10px;
    cursor: help;
  }

  .match-link { text-align: right; font-size: 12.5px; font-weight: 600; }
  .no-link { color: var(--text-muted); }
  .match-note {
    grid-column: 1 / -1;
    font-size: 12px; color: var(--text-muted); line-height: 1.55;
    padding-top: 2px;
  }

  @media (max-width: 860px) {
    .match-row { grid-template-columns: 1fr; gap: 10px; }
    .match-link { text-align: left; }
    .scoreline { justify-content: flex-start; }
  }
</style>
