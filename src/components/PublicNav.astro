---
import Logo from "./Logo.astro";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  active: "home" | "players";
}

const { active } = Astro.props;
const t = Astro.locals.t;
---

<div class="nav" id="site-nav">
  <div class="brand">
    <Logo id="lg-nav" />
    <div class="brand-text">
      <span class="brand-title">4CWC<span class="dot">.</span>ID</span>
      <span class="brand-sub">Tim Indonesia</span>
    </div>
  </div>
  <div class="nav-links">
    <a href="/" class={active === "home" ? "active" : ""}>{t("nav.home")}</a>
    <a href="/players" class={active === "players" ? "active" : ""}>{t("nav.players")}</a>
  </div>
  <div style="display:flex; align-items:center; gap:18px;">
    <LangSwitch />
    <a href="/admin/login" class="btn-ghost">{t("nav.login")}</a>
  </div>
</div>

<script>
  // Hide the header while scrolling down, bring it back on the way up.
  const nav = document.getElementById("site-nav");
  if (nav) {
    let last = window.scrollY;
    let ticking = false;
    const THRESHOLD = 6; // ignore sub-pixel jitter and rubber-banding

    const update = () => {
      const y = Math.max(0, window.scrollY);
      const delta = y - last;
      nav.dataset.scrolled = y > 4 ? "true" : "false";

      if (Math.abs(delta) > THRESHOLD) {
        // Never hide it near the very top, or the page opens headerless.
        nav.dataset.hidden = delta > 0 && y > nav.offsetHeight ? "true" : "false";
        last = y;
      }
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
