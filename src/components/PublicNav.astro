---
import Logo from "./Logo.astro";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  active: "home" | "players";
}

const { active } = Astro.props;
const t = Astro.locals.t;
---

<div class="nav">
  <div class="brand">
    <Logo id="lg-nav" />
    <div class="brand-text">
      <span class="brand-title">4CWC<span class="dot">.</span>ID</span>
      <span class="brand-sub">Tim Indonesia</span>
    </div>
  </div>
  <div class="nav-links">
    <a href="/" class={active === "home" ? "active" : ""}>{t("nav.home")}</a>
    <a href="/players" class={active === "players" ? "active" : ""}>{t("nav.players")}</a>
  </div>
  <div style="display:flex; align-items:center; gap:18px;">
    <LangSwitch />
    <a href="/admin/login" class="btn-ghost">{t("nav.login")}</a>
  </div>
</div>
